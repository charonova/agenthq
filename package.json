{
  "name": "@charonova/agenthq",
  "version": "0.1.0",
  "description": "A pixel-art office for your Claude Code sessions: every session an office, the main agent its manager, every subagent at a desk.",
  "type": "module",
  "license": "MIT",
  "author": "charonova",
  "bin": {
    "agenthq": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "test": "vitest run",
    "list": "npm run build --silent && node dist/cli.js --list",
    "start": "npm run build --silent && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json"
  },
  "keywords": [
    "claude-code",
    "agents",
    "subagents",
    "office",
    "pixel-art",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/charonova/agenthq.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
