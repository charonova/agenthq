{
  "name": "@charonova/agenthq",
  "version": "0.3.0",
  "description": "A pixel-art office for your Claude Code and Codex sessions: every session an office, the main agent its manager, every subagent at a desk.",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "subagents",
    "office",
    "pixel-art",
    "visualization",
    "developer-tools"
  ],
  "homepage": "https://charonova.github.io/agenthq/",
  "bugs": {
    "url": "https://github.com/charonova/agenthq/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/charonova/agenthq.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "charonova",
  "type": "module",
  "bin": {
    "agenthq": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts --no-open",
    "build": "tsup && node scripts/copy-web.mjs && node scripts/package-docs.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@agenthq/core": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
